@import url('https://fonts.googleapis.com/css2?family=Caveat:wght@600;700&family=Outfit:wght@200;300;400;500;600;700;800&family=Patrick+Hand&family=Playfair+Display:ital,wght@0,400;1,400&display=swap');
@import "tailwindcss";

@layer base {
  :root {
    --background: #000000;
    --foreground: #f4f3ef;
  }

  body {
    background-color: #000000;
    color: #f4f3ef;
    overflow-x: hidden;
    font-family: 'Outfit', -apple-system, BlinkMacSystemFont, sans-serif;
    font-feature-settings: "cv02", "cv03", "cv04", "cv11";
  }
}

/* Glassmorphic Pill Badges */
.glass-pill-dark {
  background: rgba(18, 16, 14, 0.85);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  border: 1px solid rgba(255, 255, 255, 0.18);
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.7);
}

/* Custom Bouncing Cursor Keyframe */
@keyframes hand-bounce-smooth {
  0%, 100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(6px);
  }
}

.animate-hand-bounce {
  animation: hand-bounce-smooth 1.4s ease-in-out infinite;
}

/* Infinite Marquee Animations */
@keyframes marquee-left {
  0% {
    transform: translateX(0%);
  }
  100% {
    transform: translateX(-50%);
  }
}

@keyframes marquee-right {
  0% {
    transform: translateX(-50%);
  }
  100% {
    transform: translateX(0%);
  }
}

.animate-marquee-left {
  display: flex;
  width: max-content;
  animation: marquee-left 35s linear infinite;
}

.animate-marquee-left:hover {
  animation-play-state: paused;
}

.animate-marquee-right {
  display: flex;
  width: max-content;
  animation: marquee-right 35s linear infinite;
}

.animate-marquee-right:hover {
  animation-play-state: paused;
}
